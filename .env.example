# Copy to .env.local for `vercel dev`. On Vercel add these under Settings -> Environment Variables.

# Turso database URL (starts with libsql://)
TURSO_DATABASE_URL=libsql://your-database-name-yourusername.aws-ap-south-1.turso.io

# Turso auth token (create a new one in the Turso dashboard; NEVER commit or share it)
TURSO_AUTH_TOKEN=paste-your-turso-token-here

# Long random string: run `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# Secret key needed ONLY to create the first owner account. Choose anything long and private.
SETUP_KEY=change-me-another-secret

# For local testing without Turso you can use a local file instead:
# TURSO_DATABASE_URL=file:local.db
